---
import Base from '../layouts/Base.astro';
---

<Base
  title="Sayfa bulunamadı | PivotEdu"
  description="Aradığınız sayfa bulunamadı."
  robots="noindex, follow"
  path="/404/"
>
  <div class="wrap nf">
    <p class="code">404</p>
    <h1>Aradığınız sayfa bulunamadı</h1>
    <p>Sayfa taşınmış veya adres yanlış yazılmış olabilir.</p>
    <p class="links">
      <a class="btn" href="/">Anasayfaya dön</a>
      <a href="/ulkeler/">Ülkeler</a>
      <a href="/yurt-disi-egitim-programlari/">Programlar</a>
      <a href="/iletisim/">İletişim</a>
    </p>
  </div>
</Base>

<style>
  .nf {
    padding-block: 80px 100px;
    text-align: center;
  }

  .code {
    font-family: var(--font-head);
    font-size: 76px;
    font-weight: 700;
    color: var(--orange);
    margin: 0;
    line-height: 1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: center;
    align-items: center;
    margin-top: 28px;
  }

  .btn {
    background: var(--orange);
    color: #fff;
    font-weight: 600;
    padding: 12px 26px;
    border-radius: 8px;
    text-decoration: none;
  }

  .btn:hover {
    background: var(--orange-dark);
    color: #fff;
  }
</style>
