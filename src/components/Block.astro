---
import Self from './Block.astro';
import LeadForm from './LeadForm.astro';
import { sectionCss, innerCss, textCss, buttonCss, isDark } from '../lib/style';

const { node } = Astro.props as { node: any };

// Ard arda gelen ayni tipteki kart bloklarini izgaraya topla.
const GRIDABLE = new Set(['iconbox', 'counter', 'image']);

function group(children: any[]) {
  const out: any[] = [];
  let buf: any[] = [];
  const flush = () => {
    if (!buf.length) return;
    if (buf.length > 1) out.push({ type: '__grid', kind: buf[0].type, items: buf });
    else out.push(buf[0]);
    buf = [];
  };
  for (const c of children) {
    if (GRIDABLE.has(c?.type) && (!buf.length || buf[0].type === c.type)) buf.push(c);
    else {
      flush();
      if (GRIDABLE.has(c?.type)) buf.push(c);
      else out.push(c);
    }
  }
  flush();
  return out;
}

const t = node?.type;

// Elementor tipografiyi iki yere yazar: widget'in kendi secicisine (baslik rengi,
// punto) ve widget konteynerinin secicisine (hizalama, punto, renk — ornegin hero
// paragrafi 18px + beyaz). Ikisini birlestiriyoruz, widget'in kendi degeri onceliklidir.
// textCss yalnizca tipografi anahtarlarini gecirir, kutu ozellikleri sizmaz.
function withAlign(styleObj: any, boxObj: any) {
  return textCss({ ...(boxObj || {}), ...(styleObj || {}) });
}

// Buton hizasi: once widget sinifi (elementor-align-*), yoksa konteynerin hizasi.
const btnAlign =
  t === 'button'
    ? node.align && node.align !== 'justify'
      ? `text-align:${node.align}`
      : node.box?.textAlign
        ? `text-align:${node.box.textAlign}`
        : undefined
    : undefined;

const rowSec = t === 'row' ? sectionCss(node.style) : undefined;
const rowInner = t === 'row' ? innerCss(node.style) : undefined;
const rowDark = t === 'row' ? isDark(node.style) : false;
const rowStyle = [rowSec, rowInner].filter(Boolean).join(';') || undefined;
---

{
  t === 'row' && (
    <div class:list={['row', { cols: node.layout === 'cols', dark: rowDark, band: !!rowSec }]} style={rowStyle}>
      {group(node.children).map((c: any) => <Self node={c} />)}
    </div>
  )
}

{
  t === '__grid' && (
    <div class={`grid grid-${node.kind}`} data-n={node.items.length}>
      {node.items.map((c: any) => <Self node={c} />)}
    </div>
  )
}

{t === 'heading' && node.level === 1 && <h1 style={withAlign(node.style, node.box)} set:html={node.html} />}
{t === 'heading' && node.level === 2 && <h2 style={withAlign(node.style, node.box)} set:html={node.html} />}
{t === 'heading' && node.level === 3 && <h3 style={withAlign(node.style, node.box)} set:html={node.html} />}
{t === 'heading' && node.level === 4 && <h4 style={withAlign(node.style, node.box)} set:html={node.html} />}
{t === 'heading' && node.level === 5 && <h5 style={withAlign(node.style, node.box)} set:html={node.html} />}
{t === 'heading' && node.level === 6 && <h6 style={withAlign(node.style, node.box)} set:html={node.html} />}

{t === 'text' && <div class="prose" style={withAlign(node.style, node.box)} set:html={node.html} />}
{t === 'raw' && <div class="prose raw" set:html={node.html} />}

{
  t === 'iconbox' && (
    <div class="card">
      <h3 class="card-t">
        {node.href ? <a href={node.href}>{node.title}</a> : node.title}
      </h3>
      {node.html && <div class="prose card-d" set:html={node.html} />}
    </div>
  )
}

{
  t === 'button' && node.href && (
    <p class:list={['btn-wrap', node.align === 'justify' && 'justify']} style={btnAlign}>
      <a class="btn" href={node.href} style={buttonCss(node.style)}>
        {node.text}
      </a>
    </p>
  )
}

{
  t === 'image' &&
    node.src &&
    (node.href ? (
      <a href={node.href} class="img-wrap">
        <img src={node.src} alt={node.alt} width={node.width} height={node.height} loading="lazy" decoding="async" />
      </a>
    ) : (
      <figure class="img-wrap">
        <img src={node.src} alt={node.alt} width={node.width} height={node.height} loading="lazy" decoding="async" />
      </figure>
    ))
}

{
  t === 'accordion' && (
    <div class="acc">
      {node.items.map((it: any) => (
        <details>
          <summary>{it.title}</summary>
          <div class="prose" set:html={it.html} />
        </details>
      ))}
    </div>
  )
}

{
  t === 'counter' && (
    <div class="counter">
      <div class="counter-n">
        {node.prefix}
        {node.number}
        {node.suffix}
      </div>
      {node.title && <div class="counter-t">{node.title}</div>}
    </div>
  )
}

{t === 'anchor' && node.id && <span id={node.id} class="anchor" />}

{
  t === 'map' && node.src && (
    <div class="map">
      <iframe src={node.src} loading="lazy" title="Harita" referrerpolicy="no-referrer-when-downgrade" />
    </div>
  )
}

{t === 'form' && <LeadForm />}

<style>
  .row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row.band {
    border-radius: inherit;
  }

  .row.dark,
  .row.dark :global(p),
  .row.dark :global(li),
  .row.dark :global(h2),
  .row.dark :global(h3),
  .row.dark :global(h4) {
    color: #fff;
  }

  .row.cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
    align-items: start;
  }

  .grid {
    display: grid;
    gap: 20px;
    margin: 14px 0 26px;
  }

  .grid-iconbox {
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  }

  .grid-counter {
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .grid-image {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 18px;
    box-shadow: 0 1px 2px rgb(15 30 64 / 5%);
    transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s;
  }

  .card:hover {
    box-shadow: var(--shadow);
    border-color: #d8dfea;
    transform: translateY(-2px);
  }

  .card-t {
    font-size: 19px;
    margin-bottom: 8px;
  }

  .card-t a {
    color: var(--navy);
    text-decoration: none;
  }

  .card-t a:hover {
    color: var(--orange-dark);
  }

  .card-d {
    font-size: 16px;
    color: var(--muted);
  }

  .card-d :global(p:last-child) {
    margin-bottom: 0;
  }

  .btn-wrap {
    margin: 8px 0 22px;
  }

  /* elementor-align-justify: buton satiri tam kaplar */
  .btn-wrap.justify .btn {
    display: block;
    text-align: center;
  }

  .btn {
    display: inline-block;
    background: var(--orange);
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    padding: 13px 28px;
    border-radius: 8px;
    /* Uretimde butonlar alti cizili geliyor (Hello Elementor'un
       ".page-content a { text-decoration: underline }" kurali butonu da yakaliyor).
       Bu istenmeyen bir yan etki oldugu icin BILEREK uretimden sapiliyor:
       buton alanlari cizgisiz, tiklanabilir metinler cizgili. */
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }

  .btn:hover {
    background: var(--orange-dark);
    color: #fff;
    transform: translateY(-1px);
  }

  .img-wrap {
    display: block;
    margin: 0 0 22px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .img-wrap img {
    width: 100%;
    object-fit: cover;
  }

  .grid-image .img-wrap {
    margin: 0;
    aspect-ratio: 4 / 3;
  }

  .grid-image .img-wrap img {
    height: 100%;
  }

  .acc {
    margin: 10px 0 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .acc details + details {
    border-top: 1px solid var(--line);
  }

  .acc summary {
    cursor: pointer;
    padding: 16px 20px;
    font-family: var(--font-head);
    font-size: 17px;
    color: var(--navy);
    background: var(--white);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
  }

  .acc summary::-webkit-details-marker {
    display: none;
  }

  .acc summary::after {
    content: '+';
    font-size: 22px;
    color: var(--orange);
    flex: none;
    line-height: 1;
  }

  .acc details[open] summary {
    background: var(--cream);
  }

  .acc details[open] summary::after {
    content: '−';
  }

  .acc details > div {
    padding: 4px 20px 18px;
  }

  /* Uretimde olculdu: kutu seffaf, dolgusuz, kosesiz ve sola yasli;
     sayi 42px/700 turuncu, baslik 16px/500 ve bolumun metin rengini miras alir. */
  .counter {
    text-align: left;
  }

  .counter-n {
    font-size: 42px;
    font-weight: 700;
    color: var(--orange);
    line-height: 1.1;
  }

  .counter-t {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 500;
    color: inherit;
  }

  .anchor {
    display: block;
    height: 0;
  }

  .map {
    margin: 10px 0 26px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .map iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: 0;
  }
</style>
