---
import { nav, site } from '../data/site';
const { path } = Astro.props as { path: string };
const isActive = (href: string) => href === path;
const inBranch = (item: (typeof nav)[number]) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---

<header class="hdr">
  <div class="wrap hdr-in">
    <a href="/" class="logo" aria-label={site.name}>
      <img src={site.logo} alt={site.logoAlt} width="250" height="100" />
    </a>

    <input type="checkbox" id="navtoggle" class="navtoggle" hidden />
    <label for="navtoggle" class="burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Ana menü">
      <ul class="lvl1">
        {
          nav.map((item) => (
            <li class={item.children ? 'has-sub' : ''}>
              <a href={item.href} aria-current={inBranch(item) ? 'page' : undefined}>
                {item.label}
                {item.children && <span class="caret" aria-hidden="true">▾</span>}
              </a>
              {item.children && (
                <ul class="lvl2">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .hdr-in {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 74px;
  }

  .logo {
    flex: none;
    line-height: 0;
  }

  .logo img {
    width: 170px;
    height: auto;
  }

  .nav {
    margin-left: auto;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lvl1 {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .lvl1 > li {
    position: relative;
    margin: 0;
  }

  .lvl1 > li > a {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 10px 11px;
    font-size: 15px;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    border-radius: 6px;
    white-space: nowrap;
  }

  .lvl1 > li > a:hover,
  .lvl1 > li > a[aria-current] {
    background: var(--gray-bg);
    color: var(--orange-dark);
  }

  .caret {
    font-size: 10px;
    opacity: 0.6;
  }

  .lvl2 {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 6px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
  }

  .has-sub:hover .lvl2,
  .has-sub:focus-within .lvl2 {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .lvl2 a {
    display: block;
    padding: 9px 12px;
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
    border-radius: 6px;
  }

  .lvl2 a:hover,
  .lvl2 a[aria-current] {
    background: var(--cream);
    color: var(--orange-dark);
  }

  /* Son iki madde vurgulu */
  .lvl1 > li:nth-last-child(2) > a {
    color: var(--orange-dark);
    font-weight: 600;
  }

  .burger {
    display: none;
  }

  @media (max-width: 1100px) {
    .lvl1 > li > a {
      padding: 10px 8px;
      font-size: 14px;
    }
    .logo img {
      width: 140px;
    }
  }

  @media (max-width: 940px) {
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      margin-left: auto;
      width: 44px;
      height: 44px;
      padding: 10px;
      cursor: pointer;
      border-radius: 6px;
    }

    .burger span {
      display: block;
      height: 2px;
      background: var(--navy);
      border-radius: 2px;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
      max-height: calc(100vh - 74px);
      overflow-y: auto;
      padding: 8px var(--pad) 20px;
    }

    .navtoggle:checked ~ .nav {
      display: block;
    }

    .lvl1 {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .lvl1 > li > a {
      padding: 12px 4px;
      font-size: 16px;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
    }

    .caret {
      display: none;
    }

    .lvl2 {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      border: 0;
      box-shadow: none;
      padding: 4px 0 8px 14px;
      min-width: 0;
    }

    .lvl2 a {
      padding: 8px 4px;
      font-size: 15px;
    }
  }
</style>
